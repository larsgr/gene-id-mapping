{
    "name": "Claude Bioinfo",
    "image": "claude-bioinfo:latest",
    "mounts": [
        "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind"
    ],
    "forwardPorts": [8787],
    "containerEnv": {
        "HOST_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
    },
    "postStartCommand": "container-setup.sh",
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "REditorSupport.r"
            ]
        }
    }
}
